# clone-chzzk 환경변수 예시. 실제 비밀 값은 넣지 마세요.
# 서버는 이 파일을 자동으로 읽지 않습니다. 셸에서 export 하거나 실행 환경에 주입하세요.

# ── 서버 (apps/server) ────────────────────────────────────
# 바인딩 주소
SERVER_ADDR=0.0.0.0:3000
# PostgreSQL 연결 주소 (필수). 로컬 개발 예: postgres://postgres:postgres@localhost:5432/postgres
# compose.yaml로 띄우면 compose가 POSTGRES_PASSWORD로 만들어 넣으므로 비워 둔다.
DATABASE_URL=
# 인스턴스 하나가 여는 DB 연결 수의 상한
DATABASE_MAX_CONNECTIONS=10
# 인스턴스 사이에 댓글·후원 알림과 송출 종료 신호를 전하는 Redis. 비우면 인스턴스 1개로 보고 프로세스 안에서만 전한다.
# 로컬 예: redis://localhost:6379 (compose.yaml로 띄우면 compose가 넣으므로 비워 둔다)
REDIS_URL=
# 녹화본 저장소: local(기본, 비밀 값 불필요) 또는 oci
STORAGE_BACKEND=local
# local 저장소: 녹화본을 둘 디렉터리
STORAGE_DIR=data/recordings
# oci 저장소 (STORAGE_BACKEND=oci일 때만 필요). 값은 실행 환경에만 넣고 저장소에 커밋하지 마세요.
# 엔드포인트 형식: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
OCI_S3_ENDPOINT=
OCI_REGION=ap-osaka-1
OCI_BUCKET=
# OCI 콘솔 > 사용자 설정 > Customer Secret Keys 에서 발급
OCI_ACCESS_KEY_ID=
OCI_SECRET_ACCESS_KEY=
# 녹화본 하나의 최대 크기(바이트). 기본 2GiB
MAX_UPLOAD_BYTES=2147483648
# 저장된 녹화본 크기 합의 한도(바이트). 기본 15GiB — OCI Object Storage 무료 한도(20GB) 안에 머물기 위한 값
STORAGE_QUOTA_BYTES=16106127360
# 라이브 송출: HLS 조각을 만드는 임시 디렉터리
LIVE_DIR=data/live
# 라이브 송출: 송출을 HLS로 바꾸는 ffmpeg 실행 파일 (없으면 송출만 거부, 녹화방송은 그대로 동작)
FFMPEG_PATH=ffmpeg
# 라이브 송출: 서비스 전체(모든 인스턴스 합)에서 동시에 진행할 수 있는 라이브 방송 수 (송출마다 ffmpeg가 CPU로 인코딩)
MAX_LIVE_BROADCASTS=2
# 라이브 송출: 영상이 이 시간(초) 동안 오지 않으면 방송을 종료
LIVE_IDLE_TIMEOUT_SECS=20
# 서버 인스턴스 이름. 비우면 호스트 이름(컨테이너에서는 컨테이너 ID). compose로 여러 인스턴스를 띄울 때는 비워 둔다
INSTANCE_ID=
# 라이브 송출: 송출 중인 인스턴스가 하트비트를 갱신하는 주기(초)
LIVE_HEARTBEAT_INTERVAL_SECS=5
# 라이브 송출: 하트비트가 이 시간(초) 넘게 끊긴 라이브 방송은 송출받던 인스턴스가 죽은 것으로 보고 종료
LIVE_HEARTBEAT_TIMEOUT_SECS=30
# 로그인 토큰(JWT) 서명 키. 실제 값은 실행 환경에만 넣고 커밋하지 마세요.
# 예: openssl rand -base64 48 로 만든 값. 비우면 서버를 시작할 때마다 임시 키를 만든다(재시작하면 모두 로그아웃)
JWT_SECRET=
# 로그인 토큰 유효 시간(초). 기본 24시간
JWT_TTL_SECS=86400
# 후원 결제: 토스페이먼츠 테스트 키(test_로 시작). 비우면 후원만 막고 나머지 기능은 그대로 동작한다.
# 개발자센터(https://developers.tosspayments.com/my/api-keys) > API 개별 연동 키에서 복사한다.
# 가입 전에는 토스페이먼츠 문서·샘플 프로젝트에 공개된 테스트 키를 쓸 수 있다(README 참고). 라이브 키(live_)는 넣지 마세요.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 결제 API 주소. 바꿀 일이 없다(테스트에서 가짜 결제 서버를 가리킬 때만 쓴다)
TOSS_API_BASE=https://api.tosspayments.com
# 브라우저 호출을 허용할 웹 출처 (쉼표 구분, *는 모두 허용)
CORS_ALLOWED_ORIGINS=http://localhost:8080
# 로그 수준
RUST_LOG=info,tower_http=info

# ── 배포 (compose.yaml) ───────────────────────────────────
# compose의 PostgreSQL 비밀번호 (필수). 예: openssl rand -hex 24 로 만든 값. 커밋하지 마세요.
POSTGRES_PASSWORD=
# 휴대폰 송출에는 HTTPS가 필요하다. 예: 158-101-1-2.sslip.io (공인 IP의 점을 대시로). 비우면 HTTP(:80)
SITE_ADDRESS=

# ── 웹 (apps/web, 빌드 시점에 읽음) ───────────────────────
# 웹이 호출할 서버 주소
API_BASE_URL=http://localhost:3000
