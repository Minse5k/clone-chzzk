# clone-chzzk 환경변수 예시. 실제 비밀 값은 넣지 마세요.
# 서버는 이 파일을 자동으로 읽지 않습니다. 셸에서 export 하거나 실행 환경에 주입하세요.

# ── 서버 (apps/server) ────────────────────────────────────
# 바인딩 주소
SERVER_ADDR=0.0.0.0:3000
# SQLite 파일 경로 (없으면 생성)
DATABASE_PATH=data/chzzk.db
# 녹화본 저장소: local(기본, 비밀 값 불필요) 또는 oci
STORAGE_BACKEND=local
# local 저장소: 녹화본을 둘 디렉터리
STORAGE_DIR=data/recordings
# oci 저장소 (STORAGE_BACKEND=oci일 때만 필요). 값은 실행 환경에만 넣고 저장소에 커밋하지 마세요.
# 엔드포인트 형식: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
OCI_S3_ENDPOINT=
OCI_REGION=ap-osaka-1
OCI_BUCKET=
# OCI 콘솔 > 사용자 설정 > Customer Secret Keys 에서 발급
OCI_ACCESS_KEY_ID=
OCI_SECRET_ACCESS_KEY=
# 녹화본 하나의 최대 크기(바이트). 기본 2GiB
MAX_UPLOAD_BYTES=2147483648
# 저장된 녹화본 크기 합의 한도(바이트). 기본 15GiB — OCI Object Storage 무료 한도(20GB) 안에 머물기 위한 값
STORAGE_QUOTA_BYTES=16106127360
# 브라우저 호출을 허용할 웹 출처 (쉼표 구분, *는 모두 허용)
CORS_ALLOWED_ORIGINS=http://localhost:8080
# 로그 수준
RUST_LOG=info,tower_http=info

# ── 웹 (apps/web, 빌드 시점에 읽음) ───────────────────────
# 웹이 호출할 서버 주소
API_BASE_URL=http://localhost:3000
